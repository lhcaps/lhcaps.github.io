{
  "name": "le-huy-systems-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:release": "node --test scripts/test/*.test.mjs",
    "generate:cv": "tsx scripts/cv/generate.ts",
    "verify:cv": "tsx scripts/cv/verify.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:build": "node scripts/validate-build.mjs",
    "stage:pages": "node scripts/stage-pages.mjs",
    "prepare:confidentiality": "tsx scripts/confidentiality.ts --write",
    "verify:confidentiality": "tsx scripts/confidentiality.ts",
    "verify:history": "node scripts/verify-history.mjs",
    "audit:history-rewrite": "node scripts/rewrite-history.mjs",
    "verify:budget": "node scripts/verify-budget.mjs",
    "verify:reviews": "node scripts/verify-reviews.mjs",
    "verify:generated:preupload": "node scripts/verify-generated-evidence.mjs --phase preupload",
    "verify:generated:hosted": "node scripts/verify-generated-evidence.mjs --phase hosted-final",
    "restore:build-evidence": "node scripts/restore-build-evidence.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "finalize:deployment": "node scripts/finalize-deployment.mjs",
    "e2e": "playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "framer-motion": "11.18.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.12.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.8",
    "autoprefixer": "10.5.0",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "pdf-lib": "1.17.1",
    "pdf-parse": "2.4.5",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "description": "Le Huy's evidence-bound software systems portfolio.",
  "engines": {
    "node": "22.23.1",
    "npm": "11.12.1"
  },
  "packageManager": "npm@11.12.1"
}
